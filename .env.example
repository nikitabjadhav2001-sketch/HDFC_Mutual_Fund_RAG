# Application
APP_NAME=rag-chatbot
APP_HOST=0.0.0.0
APP_PORT=8000
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Storage
DATABASE_URL=postgresql+psycopg2://rag:rag@localhost:5432/rag
REDIS_URL=redis://localhost:6379/0
STORAGE_DIR=storage

# LLM / embeddings
OPENAI_API_KEY=sk-...
# Optional: any OpenAI-compatible endpoint (e.g. https://api.groq.com/openai/v1)
OPENAI_BASE_URL=
LLM_MODEL=gpt-4o-mini
# "local" (sentence-transformers on-device, default), "huggingface"
# (HF Inference API, needs credits), "openai" (/embeddings endpoint),
# or "hash" (deterministic offline embedder for tests/CI)
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIM=384
HF_BASE_URL=https://router.huggingface.co/hf-inference
# Only needed for EMBEDDING_PROVIDER=huggingface: https://huggingface.co/settings/tokens
HF_TOKEN=

# RAG tuning
CHUNK_MAX_TOKENS=400
CHUNK_OVERLAP_TOKENS=80
RETRIEVAL_TOP_K=8
CONTEXT_TOKEN_BUDGET=3000
SCORE_THRESHOLD=0.0

# Phase 6: API keys (empty disables auth for that tier; ADMIN_KEY falls back to API_KEY)
API_KEY=
ADMIN_KEY=
RATE_LIMIT_PER_MINUTE=600
RATE_LIMIT_BURST=120

# Phase 6: observability
LOG_LEVEL=INFO
# OTLP endpoint (e.g. http://otel-collector:4318); empty = spans not exported
OTEL_EXPORTER_OTLP_ENDPOINT=

# Phase 6: caching / robustness
QUERY_CACHE_TTL=60
MAX_UPLOAD_BYTES=20000000
LLM_MAX_RETRIES=2
LLM_TIMEOUT_SECONDS=60.0
